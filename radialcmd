#!/usr/bin/env python3
"""
radialcmd — abre el menú radial de comandos (instantáneo: avisa al servicio
en segundo plano, radialcmd-daemon, que ya está esperando con todo cargado).

Uso:
  radialcmd                 abre/cierra el menú (como un interruptor)
  radialcmd -f otro.txt     abre el menú con otro archivo de comandos
  radialcmd --edit          abre el archivo de comandos activo en el editor
  radialcmd --which         muestra qué archivos se están usando
  radialcmd --status        dice si el servicio en segundo plano está activo
  radialcmd --hook          añade a ~/.bashrc el aviso del directorio actual

Por proyecto: si la última terminal en la que pulsaste Enter está dentro de
una carpeta con un archivo .radialcmd (o en una carpeta superior), se añade a
los generales. Si está dentro de un workspace colcon (src/ + install/), sale
sola una categoría con source, build por paquete y sus launch files.

Qué archivo se usa (el primero que exista de esta lista):
  1. -f ARCHIVO
  2. la variable RADIALCMD_FILE del entorno (si lo lanzas desde una terminal)
  3. la última línea  export RADIALCMD_FILE=...  de ~/.bashrc
  4. ~/.config/radialcmd/comandos.txt
  RADIALCMD_FILE admite varios archivos separados por ":"; se combinan y las
  secciones con el mismo nombre se juntan. Ej. comandos generales + proyecto:
    export RADIALCMD_FILE=~/.config/radialcmd/comandos.txt:~/mi_proyecto/comandos.txt

Formato del archivo:
  # comentario
  [Categoría]               crea una categoría (abre un anillo nuevo)
  [Categoría/Sub]           subcategoría
  []                        vuelve al nivel raíz
  Etiqueta => comando       entrada (el comando puede llevar |, &&, ::, etc.)
  comando suelto            la etiqueta es el propio comando
  ! Etiqueta => comando     peligroso: sector en rojo, pide un segundo click
  Hz => ros2 topic hz {topic}   {hueco}: al elegirlo se ofrecen las opciones
                            ({topic} {node} {service} {iface} {container}
                            {pkg} {launch}); sin generador, se escribe a mano
  @topic = comando          generador propio: una opción por línea de salida

Controles:
  ratón: click en sector = elegir / entrar   click centro o botón dcho = atrás
         Shift+click = copiar y pegar en la ventana activa (necesita xdotool)
         click fuera del anillo = cerrar
  teclado: 1-9, 0 = elegir sector   letras = buscar   Enter = el primero
           Backspace = atrás   Esc = cerrar
  volver a pulsar el atajo con el menú abierto lo cierra
"""
import os
import socket
import sys

# Ruta rápida (la del atajo de teclado): sin argumentos solo hace falta el
# socket. Se avisa al servicio antes de importar nada más, para no gastar
# tiempo cargando argparse/subprocess/pathlib en cada pulsación.
if len(sys.argv) == 1:
    _s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    _s.settimeout(0.3)
    try:
        _s.connect(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "radialcmd.sock"))
        _s.sendall(b"TOGGLE")
        if _s.recv(16) == b"OK":
            sys.exit(0)
    except OSError:
        pass                                 # sigue por el camino normal (arranca el servicio)
    finally:
        _s.close()

import argparse
import subprocess
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import radialcmd_core as core

DAEMON = Path(os.path.dirname(os.path.abspath(__file__))) / "radialcmd-daemon"
CONNECT_TIMEOUT = 0.3
START_WAIT_S = 2.0


def _send(msg, timeout=CONNECT_TIMEOUT):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(str(core.SOCK))
        s.sendall(msg.encode())
        return s.recv(16) == b"OK" or msg == "PING"
    finally:
        s.close()


def _alive():
    try:
        return _send("PING")
    except OSError:
        return False


def _start_daemon():
    subprocess.Popen([sys.executable, str(DAEMON)], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + START_WAIT_S
    while time.monotonic() < deadline:
        if _alive():
            return True
        time.sleep(0.03)
    return False


def trigger(override=None):
    msg = f"TOGGLE:{override}" if override else "TOGGLE"
    try:
        if _send(msg):
            return
    except OSError:
        pass
    # el servicio no está activo (p. ej. systemd aún no lo arrancó): lo
    # levantamos ahora mismo. Solo pasa la primera vez tras iniciar sesión.
    if not _start_daemon():
        sys.exit("No se pudo arrancar radialcmd-daemon. Prueba:\n"
                 "  systemctl --user status radialcmd\n"
                 "  python3 " + str(DAEMON))
    try:
        _send(msg)
    except OSError as ex:
        sys.exit(f"No se pudo hablar con radialcmd-daemon: {ex}")


def main():
    ap = argparse.ArgumentParser(description="Menú radial de comandos → portapapeles",
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__)
    ap.add_argument("-f", "--file", type=Path)
    ap.add_argument("--edit", action="store_true", help="abrir el archivo de comandos activo")
    ap.add_argument("--which", action="store_true", help="mostrar qué archivos se usan")
    ap.add_argument("--status", action="store_true", help="comprobar si el servicio está activo")
    ap.add_argument("--hook", action="store_true", help="añadir a ~/.bashrc el aviso del directorio")
    a = ap.parse_args()

    if a.hook:
        print("Añadido a ~/.bashrc (abre una terminal nueva)" if core.install_hook()
              else "Ya estaba en ~/.bashrc")
        return

    if a.status:
        print("Servicio activo" if _alive() else "Servicio NO activo (se arrancará al abrir el menú)")
        return

    if a.which:
        files, origin = core.resolve_files(a.file)
        print(f"Origen: {origin}")
        for f in files:
            print(f"  {'✓' if f.is_file() else '✗ no existe'}  {f}")
        cwd = core.active_cwd()
        if cwd is None:
            print("Directorio activo: desconocido (falta el hook: radialcmd --hook)")
        elif not a.file:
            print(f"Directorio activo: {cwd}")
            proj, ws = core.find_project_file(cwd), core.find_colcon_ws(cwd)
            print(f"  proyecto:  {proj or '—'}")
            print(f"  workspace: {ws or '—'}")
        return

    if a.edit:
        files, _ = core.resolve_files(a.file)
        f = files[-1]                       # el más específico (el del proyecto)
        f.parent.mkdir(parents=True, exist_ok=True)
        f.touch(exist_ok=True)
        subprocess.Popen(["xdg-open", str(f)])
        return

    trigger(str(a.file) if a.file else None)


if __name__ == "__main__":
    main()
